#include <windows.h>
#include "resource.h"
#include "Version.h"

// Version resource — this is what Notepad++ (Plugins Admin) reads to show the
// plugin's version. Without it the version column is blank. Values come from
// the generated Version.h (sourced from project() VERSION in CMakeLists.txt).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ANSI_VER_MAJOR,ANSI_VER_MINOR,ANSI_VER_PATCH,0
 PRODUCTVERSION ANSI_VER_MAJOR,ANSI_VER_MINOR,ANSI_VER_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "UNIVERSAL I.T SYSTEMS"
            VALUE "FileDescription",  "ANSI Color Text - Notepad++ plugin"
            VALUE "FileVersion",      ANSI_VER_STRING
            VALUE "InternalName",     "ANSI_COLOR_TEXT"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Antony J Ingram, UNIVERSAL I.T SYSTEMS"
            VALUE "OriginalFilename", "ANSI_COLOR_TEXT.dll"
            VALUE "ProductName",      "ANSI Color Text"
            VALUE "ProductVersion",   ANSI_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 240, 210
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ANSI Color Text - Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Rendering", -1, 7, 5, 226, 78

    LTEXT           "Wrap column (0 = no wrap):", -1, 16, 20, 130, 9
    EDITTEXT        IDC_MAXWIDTH, 160, 18, 60, 12, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "Screen height (0 = unbounded):", -1, 16, 36, 130, 9
    EDITTEXT        IDC_HEIGHT, 160, 34, 60, 12, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "Tab width (columns):", -1, 16, 52, 130, 9
    EDITTEXT        IDC_TABWIDTH, 160, 50, 60, 12, ES_AUTOHSCROLL | ES_NUMBER

    AUTOCHECKBOX    "Erase fills with current background", IDC_ERASEBG, 16, 66, 200, 10
    AUTOCHECKBOX    "Enable scroll region (DECSTBM)", IDC_SCROLLRGN, 16, 76, 200, 10

    GROUPBOX        "Default background", -1, 7, 90, 226, 26
    AUTORADIOBUTTON "Black", IDC_BG_BLACK, 16, 101, 50, 10, WS_GROUP
    AUTORADIOBUTTON "White", IDC_BG_WHITE, 76, 101, 50, 10

    GROUPBOX        "Animation && blink", -1, 7, 122, 226, 60
    LTEXT           "Blink interval (ms):", -1, 16, 137, 130, 9
    EDITTEXT        IDC_BLINK, 160, 135, 60, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Animation frame delay (ms):", -1, 16, 153, 130, 9
    EDITTEXT        IDC_ANIMDELAY, 160, 151, 60, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Animation bytes per frame:", -1, 16, 169, 130, 9
    EDITTEXT        IDC_ANIMCHUNK, 160, 167, 60, 12, ES_AUTOHSCROLL | ES_NUMBER

    DEFPUSHBUTTON   "OK", IDOK, 122, 189, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 183, 189, 50, 14
END

IDD_EDITOR DIALOGEX 0, 0, 200, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Apply ANSI Color to Selection"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Color", -1, 7, 5, 186, 52
    AUTOCHECKBOX    "Set foreground", IDC_FG_SET, 16, 18, 90, 10
    PUSHBUTTON      "Choose...", IDC_FG_PICK, 120, 16, 60, 14
    AUTOCHECKBOX    "Set background", IDC_BG_SET, 16, 36, 90, 10
    PUSHBUTTON      "Choose...", IDC_BG_PICK, 120, 34, 60, 14

    GROUPBOX        "Attributes", -1, 7, 60, 186, 64
    AUTOCHECKBOX    "Bold", IDC_AT_BOLD, 16, 73, 80, 10
    AUTOCHECKBOX    "Italic", IDC_AT_ITALIC, 104, 73, 80, 10
    AUTOCHECKBOX    "Underline", IDC_AT_UNDERLINE, 16, 89, 80, 10
    AUTOCHECKBOX    "Blink", IDC_AT_BLINK, 104, 89, 80, 10
    AUTOCHECKBOX    "Inverse", IDC_AT_INVERSE, 16, 105, 80, 10
    AUTOCHECKBOX    "Strikethrough", IDC_AT_STRIKE, 104, 105, 80, 10

    DEFPUSHBUTTON   "Apply", IDOK, 82, 138, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 138, 138, 50, 14
END

IDD_AI DIALOGEX 0, 0, 260, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Provider:", -1, 12, 14, 50, 9
    COMBOBOX        IDC_AI_PROVIDER, 70, 12, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Base URL:", -1, 12, 34, 50, 9
    EDITTEXT        IDC_AI_BASE, 70, 32, 178, 12, ES_AUTOHSCROLL
    LTEXT           "Model:", -1, 12, 52, 50, 9
    EDITTEXT        IDC_AI_MODEL, 70, 50, 178, 12, ES_AUTOHSCROLL
    LTEXT           "API key:", -1, 12, 70, 50, 9
    EDITTEXT        IDC_AI_KEY, 70, 68, 178, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Keys are stored DPAPI-encrypted (per Windows user). Ollama local needs no key.", -1, 12, 88, 236, 18
    DEFPUSHBUTTON   "Save", IDOK, 142, 108, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 198, 108, 50, 14
END

IDD_GENERATE DIALOGEX 0, 0, 260, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Generate ANSI with AI"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Describe the ANSI art or animation to generate:", -1, 12, 10, 236, 9
    EDITTEXT        IDC_GEN_PROMPT, 12, 22, 236, 90, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    AUTOCHECKBOX    "Generate as animation", IDC_GEN_ANIMATION, 12, 118, 130, 10
    LTEXT           "", IDC_GEN_PROVIDER, 12, 132, 236, 9
    DEFPUSHBUTTON   "Generate", IDOK, 142, 140, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 198, 140, 50, 14
END
